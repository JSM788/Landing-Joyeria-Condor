---
import { siteConfig } from '../data/siteConfig';

const WHATSAPP_NUMBER = siteConfig.contact.whatsapp;
const products = siteConfig.products;

const waLink = (name: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hola, quisiera consultar disponibilidad de: ${name}.`)}`;
---

<section class="products reveal-section" id="productos" aria-labelledby="products-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Nuestros productos</p>
      <h2 id="products-heading">Piezas seleccionadas</h2>
    </div>

    <div class="product-grid">
      {products.map((p, i) => (
        <article class="product-card" style={`--stagger-delay: ${i * 120}ms;`}>
          <div class="product-image">
            <img src={p.img} alt={`${p.name} — ${p.category}, CÓNDOR Joyería y Relojería`} loading="lazy" width="600" height="750" />
            <div class="light-sweep" aria-hidden="true"></div>
          </div>
          <div class="product-info">
            <p class="product-category">{p.category}</p>
            <h3>{p.name}</h3>
            <p class="product-price">{p.price}</p>
            <a class="product-cta" href={waLink(p.name)} target="_blank" rel="noopener noreferrer">
              Consultar disponibilidad <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="products-footer">
      <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola, quisiera ver el catálogo completo de productos.')}`}
         target="_blank" rel="noopener noreferrer" class="btn btn-outline">
        Ver catálogo completo
      </a>
    </div>
  </div>
</section>

<style>
  .products {
    padding: var(--section-pad) 0;
    background: var(--ivory);
  }
  .section-head {
    margin-bottom: 3.5rem;
    max-width: 560px;
  }
  .section-head .eyebrow {
    margin-bottom: 1rem;
  }
  .section-head h2 {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.4rem;
  }

  /* Tarjeta de producto limpia sin marcos artificiales */
  .product-card {
    background: transparent;
    padding: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--stagger-delay, 0ms);
    will-change: opacity, transform;
  }

  .product-card:hover {
    transform: translateY(-4px);
  }

  :global(.products.is-visible) .product-card {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  .product-image {
    aspect-ratio: 4 / 5;
    background: var(--ivory-deep);
    overflow: hidden;
    margin-bottom: 1.3rem;
    position: relative;
    border-radius: var(--radius-md);
    border: none;
    box-shadow: 
      0 16px 40px rgba(28, 20, 10, 0.22),
      0 0 25px rgba(28, 20, 10, 0.12),
      0 4px 12px rgba(28, 20, 10, 0.08);
    transition: box-shadow 0.4s ease;
  }
  .product-card:hover .product-image {
    box-shadow: 
      0 22px 50px rgba(28, 20, 10, 0.30),
      0 0 35px rgba(28, 20, 10, 0.16),
      0 6px 16px rgba(28, 20, 10, 0.10);
  }
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-card:hover .product-image img {
    transform: scale(1.05);
  }

  /* Haz de luz / Light sweep metálico en hover */
  .light-sweep {
    position: absolute;
    top: -50%;
    left: -75%;
    width: 50%;
    height: 200%;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.22) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(25deg);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.8s ease, opacity 0.3s ease;
  }
  .product-card:hover .light-sweep {
    opacity: 1;
    transform: rotate(25deg) translate(400%, 0);
  }

  .product-category {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 0.5rem;
  }
  .product-info h3 {
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .product-price {
    font-family: var(--font-display);
    color: var(--gold);
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .product-cta {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--line-on-light);
    padding-bottom: 2px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .product-cta:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  .products-footer {
    margin-top: 3.5rem;
    display: flex;
    justify-content: center;
  }

  @media (max-width: 980px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }
  }
</style>
