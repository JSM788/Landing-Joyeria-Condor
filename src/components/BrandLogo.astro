---
export interface Props {
  variant?: 'light' | 'dark' | 'gold';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'light', size = 'md' } = Astro.props;
---

<div class={`brand-logo variant-${variant} size-${size}`}>
  <svg class="condor-icon" viewBox="0 0 124 38" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path
      d="M62,18 C63.5,15.2 66,13.8 69,13.5 C70.8,13.3 73,14 74.5,13.2 C75.5,12.7 76,11.2 78,10.5 C82,9 87.5,8 94,7 C100.5,6 107.5,5 114,2.5 C117.5,1.2 121,0 123.5,0 C122.2,1.8 120.5,3.2 118.5,4.4 C120,5.1 122,5.7 123.5,6 C121.5,7.2 119.2,8.2 116.5,9 C118.2,10 119.8,10.8 121.2,11.5 C118,12.5 114,13.2 109.5,13.8 C111.2,14.8 112.5,15.5 113.5,16.2 C109.8,17 105,17.5 98.5,17.8 C91.8,18.2 84,18.2 77.5,19 C73,19.5 68.5,20.8 65.5,22.8 C63,24.5 61.5,26.8 60.5,29.5 C60,30.8 59.2,32 58.2,33 C57.2,32 56.4,30.8 55.9,29.5 C54.9,26.8 53.4,24.5 50.9,22.8 C47.9,20.8 43.4,19.5 38.9,19 C32.4,18.2 24.6,18.2 17.9,17.8 C11.4,17.5 6.6,17 2.9,16.2 C3.9,15.5 5.2,14.8 6.9,13.8 C2.4,13.2 -1.6,12.5 -4.8,11.5 C-3.4,10.8 -1.8,10 -0.1,9 C-2.8,8.2 -5.1,7.2 -7.1,6 C-5.6,5.7 -3.6,5.1 -2.1,4.4 C-4.1,3.2 -5.8,1.8 -7.1,0 C-4.6,0 -1.1,1.2 2.4,2.5 C8.9,5 15.9,6 22.4,7 C28.9,8 34.4,9 38.4,10.5 C40.4,11.2 40.9,12.7 41.9,13.2 C43.4,14 45.6,13.3 47.4,13.5 C50.4,13.8 52.9,15.2 54.4,18 Z"
      fill="currentColor"
    />
    <circle cx="58.2" cy="20.5" r="2.8" fill="var(--gold-pale)" />
    <path d="M57.5,17.5 C57.5,15.5 59.5,15.5 59.5,17.5 Z" fill="currentColor" />
  </svg>
  <div class="brand-text">
    <span class="brand-title">CÓNDOR</span>
    <span class="brand-rule"></span>
    <span class="brand-subtitle">Joyería &amp; Relojería</span>
    <span class="brand-since">desde 1943</span>
  </div>
</div>

<style>
  .brand-logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }
  .brand-logo:hover {
    opacity: 0.88;
  }

  /* Color variants */
  .variant-light {
    color: var(--ivory);
  }
  .variant-light .brand-title {
    color: var(--ivory);
  }
  .variant-light .brand-rule {
    background: var(--gold);
  }
  .variant-light .brand-subtitle {
    color: var(--stone-light);
  }
  .variant-light .brand-since {
    color: var(--stone-light);
  }

  .variant-dark {
    color: var(--ink);
  }
  .variant-dark .brand-title {
    color: var(--ink);
  }
  .variant-dark .brand-rule {
    background: var(--gold);
  }
  .variant-dark .brand-subtitle {
    color: var(--stone);
  }
  .variant-dark .brand-since {
    color: var(--stone);
  }

  .variant-gold {
    color: var(--gold-pale);
  }
  .variant-gold .brand-title {
    color: var(--gold-pale);
  }
  .variant-gold .brand-rule {
    background: var(--gold);
  }
  .variant-gold .brand-subtitle {
    color: var(--ivory-deep);
  }
  .variant-gold .brand-since {
    color: var(--gold-pale);
  }

  /* Sizes */
  .size-sm .condor-icon {
    width: 48px;
    height: auto;
    margin-bottom: 2px;
  }
  .size-sm .brand-title {
    font-size: 1.05rem;
    letter-spacing: 0.14em;
  }
  .size-sm .brand-subtitle {
    font-size: 0.52rem;
    letter-spacing: 0.08em;
  }
  .size-sm .brand-since {
    font-size: 0.44rem;
  }

  .size-md .condor-icon {
    width: 64px;
    height: auto;
    margin-bottom: 3px;
  }
  .size-md .brand-title {
    font-size: 1.32rem;
    letter-spacing: 0.16em;
  }
  .size-md .brand-subtitle {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }
  .size-md .brand-since {
    font-size: 0.5rem;
  }

  .size-lg .condor-icon {
    width: 86px;
    height: auto;
    margin-bottom: 4px;
  }
  .size-lg .brand-title {
    font-size: 1.8rem;
    letter-spacing: 0.18em;
  }
  .size-lg .brand-subtitle {
    font-size: 0.76rem;
    letter-spacing: 0.1em;
  }
  .size-lg .brand-since {
    font-size: 0.58rem;
  }

  .condor-icon {
    display: block;
    color: inherit;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brand-title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1;
  }
  .brand-rule {
    width: 90%;
    height: 1px;
    margin: 3px 0 2px;
    opacity: 0.6;
  }
  .brand-subtitle {
    font-family: var(--font-body);
    font-weight: 500;
    line-height: 1.2;
  }
  .brand-since {
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: 0.04em;
    opacity: 0.85;
    margin-top: 1px;
  }
</style>
