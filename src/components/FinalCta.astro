---
import { siteConfig } from '../data/siteConfig';

const WHATSAPP_NUMBER = siteConfig.contact.whatsapp;
---

<section class="final-cta" aria-labelledby="final-cta-heading">
  <div class="container">
    <div class="dial-divider" aria-hidden="true">
      <span class="rule"></span>
      <span class="tick major"></span>
      <span class="tick"></span>
      <span class="tick"></span>
      <span class="tick major"></span>
      <span class="rule"></span>
    </div>

    <h2 id="final-cta-heading" class="sr-only">¿Qué necesitas hoy?</h2>

    <div class="cta-grid">
      <div class="cta-block">
        <p class="eyebrow">Servicio técnico</p>
        <h3>¿Tu reloj necesita reparación o mantenimiento?</h3>
        <p class="cta-copy">Nuestro equipo de maestros relojeros puede ayudarte.</p>
        <a
          class="btn btn-outline-dark"
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola, quisiera hablar sobre la reparación de mi reloj.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Hablar por WhatsApp
        </a>
      </div>

      <div class="cta-divider" aria-hidden="true"></div>

      <div class="cta-block">
        <p class="eyebrow">Venta de productos</p>
        <h3>¿Buscas un nuevo reloj o una joya exclusiva?</h3>
        <p class="cta-copy">Piezas seleccionadas, con la garantía de 80 años de trayectoria.</p>
        <a class="btn btn-outline-dark" href="#productos">
          Ver catálogo de productos
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .final-cta {
    padding: var(--section-pad) 0;
    background: var(--carbon);
  }
  .final-cta .dial-divider .tick {
    background: var(--line-on-dark);
  }
  .final-cta .dial-divider .rule {
    background: var(--line-on-dark);
  }
  .final-cta .dial-divider {
    margin-bottom: var(--section-pad);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 3rem;
    align-items: start;
  }
  .cta-block h3 {
    color: var(--ivory);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin: 1rem 0 0.8rem;
    max-width: 420px;
  }
  .cta-copy {
    color: var(--stone-light);
    font-size: 0.95rem;
    margin-bottom: 1.8rem;
    max-width: 380px;
  }
  .cta-divider {
    width: 1px;
    background: var(--line-on-dark);
    align-self: stretch;
  }

  @media (max-width: 820px) {
    .cta-grid {
      grid-template-columns: 1fr;
      gap: 2.6rem;
    }
    .cta-divider {
      width: 100%;
      height: 1px;
    }
  }
</style>
